//Build script for use with kalamake. Read more at https://github.com/kalakit/kalamake

#version 1.0

#references
name_bin: kaladatabase
dir_release: build/release-
dir_debug: build/debug-
name_kd: kaladatabase
dir_kd: ../../build/0-0-1
comm_objcopy: objcopy --remove-section .note.gnu.property
links_win_only: msvcrt, msvcprt, ucrt, vcruntime, shell32, user32
links_win_on_linux_only: winpthread

lib_libgcc: /usr/x86_64-w64-mingw32/bin/libgcc_s_seh-1.dll
lib_libstdcpp: /usr/x86_64-w64-mingw32/bin/libstdc++-6.dll
lib_libwinp: /usr/x86_64-w64-mingw32/bin/libwinpthread-1.dll

#global
compilerlauncher: ccache
compiler: clang++
standard: c++20
binarytype: executable
binaryname: ${name_bin}
sources: "src"
headers: "../../include", "../../external/kalaheaders/include"
defines: LIB_STATIC
warninglevel: normal
customflags: export-compile-commands, export-vscode-sln

#profile debug-windows
buildtype: debug
buildpath: "${dir_debug}windows"
links: "${dir_kd}/${name_kd}d.lib", ${links_win_only}
postbuildaction: xcopy "test_files" "${dir_debug}windows" /E /I /H /Y

#profile release-windows
buildtype: minsizerel
buildpath: "${dir_release}windows"
links: "${dir_kd}/${name_kd}.lib", ${links_win_only}
postbuildaction: xcopy "test_files" "${dir_release}windows" /E /I /H /Y

#profile debug-windows-gnu
targettype: windows-gnu
buildtype: debug
buildpath: "${dir_debug}windows-gnu"
links: "${dir_kd}/${name_kd}-gnud.lib", ${links_win_on_linux_only}
postbuildaction: cp "${lib_libgcc}" "${dir_debug}windows-gnu"
postbuildaction: cp "${lib_libstdcpp}" "${dir_debug}windows-gnu"
postbuildaction: cp "${lib_libwinp}" "${dir_debug}windows-gnu"
postbuildaction: cp -rf "test_files" "${dir_debug}windows-gnu"

#profile release-windows-gnu
targettype: windows-gnu
buildtype: minsizerel
buildpath: "${dir_release}windows-gnu"
links: "${dir_kd}/${name_kd}-gnu.lib", ${links_win_on_linux_only}
postbuildaction: cp "${lib_libgcc}" "${dir_release}windows-gnu"
postbuildaction: cp "${lib_libstdcpp}" "${dir_release}windows-gnu"
postbuildaction: cp "${lib_libwinp}" "${dir_release}windows-gnu"
postbuildaction: cp -rf "test_files" "${dir_release}windows-gnu"

#profile debug-linux
buildtype: debug
buildpath: "${dir_debug}linux"
links: "${dir_kd}/lib${name_kd}d.a"
//strips stupid avx requirements that cachyos seems to add for no reason
postbuildaction: ${comm_objcopy} ${dir_debug}linux/${name_bin}
postbuildaction: cp -rf "test_files" "${dir_debug}linux"

#profile release-linux
buildtype: minsizerel
buildpath: "${dir_release}linux"
links: "${dir_kd}/lib${name_kd}.a"
//strips stupid avx requirements that cachyos seems to add for no reason
postbuildaction: ${comm_objcopy} ${dir_release}linux/${name_bin}
postbuildaction: strip --strip-unneeded ${dir_release}linux/${name_bin}
postbuildaction: cp -rf "test_files" "${dir_release}linux"

